{
  "name": "@sasarjan/web-core",
  "version": "0.0.0",
  "description": "Shared footer, ecosystem links, /ecosystem introduction page and content for the SaSarjan family of websites.",
  "license": "MIT",
  "author": "SaSarjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaysanghani/SaSarjan-Common-Core-Content.git"
  },
  "homepage": "https://github.com/ajaysanghani/SaSarjan-Common-Core-Content#readme",
  "bugs": "https://github.com/ajaysanghani/SaSarjan-Common-Core-Content/issues",
  "keywords": [
    "sasarjan",
    "react",
    "nextjs",
    "footer",
    "server-components"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.32.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:react18": "node scripts/ensure-react18.mjs && vitest run --config vitest.react18.config.ts",
    "check:drafts": "node scripts/check-drafts.mjs",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css",
    "check:pack": "node scripts/check-pack.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:react18 && pnpm build && pnpm check:package && pnpm check:pack",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:examples": "node scripts/test-examples.mjs",
    "verify:release": "pnpm verify && pnpm test:examples",
    "prepublishOnly": "pnpm verify"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
